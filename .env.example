# ---- Required ----
ANTHROPIC_API_KEY=

# ---- Where deploy announcements come from: slack | discord | file ----
CHAT_SOURCE=file
CHAT_FILE=fixtures/deploy-announcements.json
# Slack: bot token with channels:history (groups:history for private channels); invite the bot to the channel
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WORKSPACE_URL=https://your-workspace.slack.com
# Discord: bot token with Read Message History and the Message Content intent
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# ---- Linked sources that back each change ----
CONTEXT_PROVIDERS=jira,github,docs
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=
GITHUB_TOKEN=
# Hosts the docs provider may fetch (comma separated), e.g. help.example.com
DOC_ALLOWED_HOSTS=

# ---- Product context ----
PRODUCT_CONFIG=product.json
PRODUCT_SITE_URLS=

# ---- Where drafts are written: markdown | notion | google-docs ----
DESTINATION=markdown
MARKDOWN_OUT_DIR=out
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ---- Behaviour ----
GROUP_BY=release        # release (by version, else by day) | day
TIME_ZONE=America/Toronto
AUDIENCES=instructor,student,internal
LOOKBACK_DAYS=7
RUN_EVERY_MINUTES=0     # >0 runs the digest and syncs approvals on a timer
ADMIN_TOKEN=            # protects the review screen and run/approve routes; set it in production
WIDGET_ALLOWED_ORIGIN=* # set to your product origin in production
PORT=3000
STORE_PATH=data/store.json
# Also write the approved feed as static JSON here (upload this folder to a CDN; the widget reads it with the feed= attribute)
FEED_DIR=
# ANTHROPIC_MODEL=claude-opus-5-5
